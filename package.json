{
  "name": "fast-reading-time",
  "version": "1.0.0",
  "description": "A fast, zero-dependency, dual-format (ESM & CJS) reading time estimator with Markdown/HTML stripping, CJK support, and multi-language localization.",
  "author": "Sezer Gümüş <sezer2004@gmail.com> (https://github.com/Sezergumus)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "reading-time",
    "reading-time-estimator",
    "reading-speed",
    "word-count",
    "cjk",
    "markdown-stripper",
    "html-stripper",
    "i18n",
    "time-to-read",
    "article-reading-time",
    "zero-dependency",
    "esm",
    "cjs",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sezergumus/fast-reading-time.git"
  },
  "bugs": {
    "url": "https://github.com/Sezergumus/fast-reading-time/issues"
  },
  "homepage": "https://github.com/Sezergumus/fast-reading-time#readme",
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^3.0.7",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
